{
  "name": "shiki-react-native",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write",
    "prettier:all": "prettier . --check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "check-up": "yarn lint && yarn type-check && yarn test",
    "install-gems": "bundle install",
    "install-pods": "cd ios && bundle exec pod install && cd ..",
    "bootstrap": "yarn install-gems && yarn install-pods",
    "start": "expo start --dev-client",
    "start:clear": "yarn start --clear",
    "ios": "expo run:ios --device='iPhone 16'",
    "android": "expo run:android",
    "open-ios": "open ios/Shiki.xcworkspace",
    "open-android": "open -a /Applications/Android\\ Studio.app android",
    "storybook:generate": "sb-rn-get-stories -js",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED='true' yarn start",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED='true' yarn ios",
    "storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED='true' yarn android",
    "detox:ios-build": "detox build --configuration ios.sim.release",
    "detox:ios-test": "detox test --configuration ios.sim.release",
    "detox:android-build": "detox build --configuration android.emu.release",
    "detox:android-test": "detox test --configuration android.emu.release",
    "generate-shikimori-api": "graphql-codegen --config tools/graphql/generate-shikimori-api.ts",
    "postinstall": "yarn generate-shikimori-api"
  },
  "dependencies": {
    "@apollo/client": "4.0.9",
    "@gorhom/bottom-sheet": "5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.5.0",
    "@react-native-community/slider": "5.1.0",
    "@react-navigation/native": "7.1.19",
    "@react-navigation/native-stack": "7.6.2",
    "@storybook/addon-ondevice-actions": "10.0.1",
    "@storybook/addon-ondevice-controls": "10.0.1",
    "@storybook/react-native": "10.0.1",
    "expo": "54.0.21",
    "expo-constants": "18.0.10",
    "expo-splash-screen": "31.0.10",
    "expo-system-ui": "6.0.8",
    "graphql": "16.12.0",
    "immer": "10.2.0",
    "inversify": "7.10.4",
    "mobx": "6.15.0",
    "mobx-react-lite": "4.1.1",
    "mobx-utils": "6.1.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-app-auth": "8.1.0",
    "react-native-edge-to-edge": "1.7.0",
    "react-native-gesture-handler": "2.29.0",
    "react-native-nitro-modules": "0.31.4",
    "react-native-reanimated": "4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.18.0",
    "react-native-svg": "15.14.0",
    "react-native-unistyles": "3.0.17",
    "react-native-worklets": "0.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/introspection": "5.0.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-document-nodes": "5.0.2",
    "@graphql-codegen/typescript-resolvers": "5.1.0",
    "@react-native/metro-config": "0.81.5",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.1.13",
    "detox": "20.45.1",
    "eslint": "9.39.0",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "29.7.0",
    "jest-expo": "54.0.13",
    "lefthook": "2.0.2",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "react-native-svg-transformer": "1.5.1",
    "storybook": "10.0.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.10.3",
  "private": true
}
