{
  "name": "shiki-react-native",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write",
    "prettier:all": "prettier . --check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "install-gems": "bundle install",
    "install-pods": "cd ios && bundle exec pod install && cd ..",
    "bootstrap": "yarn install-gems && yarn install-pods",
    "start": "expo start --dev-client",
    "start:clear": "yarn start --clear",
    "ios": "expo run:ios --device='iPhone 16'",
    "android": "expo run:android",
    "open-ios": "open ios/Shiki.xcworkspace",
    "open-android": "open -a /Applications/Android\\ Studio.app android"
  },
  "dependencies": {
    "@react-navigation/native": "7.1.17",
    "@react-navigation/native-stack": "7.3.26",
    "expo": "54.0.8",
    "expo-constants": "18.0.9",
    "expo-splash-screen": "31.0.10",
    "expo-system-ui": "6.0.7",
    "mobx": "6.13.7",
    "mobx-react-lite": "4.1.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-app-auth": "8.0.3",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.0",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.13.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.81.1",
    "@types/react": "19.1.13",
    "eslint": "9.35.0",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "lefthook": "1.13.1",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "react-native-svg-transformer": "1.5.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.9.4",
  "private": true
}
